---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Catering | Mega Texas BBQ">
  <Header />
  <main class="bg-bg-light min-h-screen pb-24">
    <div class="relative bg-black text-white py-32 px-6 md:px-12 text-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/interior.jpg" alt="Mega Texas BBQ Interior" class="w-full h-full object-cover opacity-80" />
      </div>
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-black via-black/60 to-primary-red/40"></div>
      <div class="relative z-20">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-6">CATERING</h1>
        <p class="text-xl opacity-90 max-w-2xl mx-auto font-medium leading-relaxed">
          From corporate events to family reunions, we bring the authentic Texas pit experience to your doorstep. Operating 7 days a week for all your catering needs.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 mt-16 grid md:grid-cols-2 gap-16 items-start">
      <div class="space-y-12">
        <section class="space-y-6">
          <h2 class="text-4xl font-extrabold text-primary-red">The Full Pit Experience</h2>
          <p class="text-lg text-text-muted leading-relaxed">
            Mega Texas BBQ offers more than just food; we offer an experience. Our catering team is dedicated to providing the highest quality smoked meats and sides for events of all sizes.
          </p>
          <ul class="space-y-4">
            {[
              { title: "7-Day Service", desc: "Our storefront may be Wed-Sun, but we cater every single day." },
              { title: "Custom Menus", desc: "Choose from our signature meats or work with us for something unique." },
              { title: "Professional Service", desc: "Reliable, on-time, and ready to serve the valley's best BBQ." }
            ].map(benefit => (
              <li class="flex gap-4">
                <div class="mt-1 bg-primary-red/10 p-2 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-primary-red"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <h3 class="font-bold text-text-dark text-lg">{benefit.title}</h3>
                  <p class="text-text-muted">{benefit.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <h3 class="text-2xl font-bold text-primary-red mb-4">Direct Contact</h3>
          <p class="text-text-muted mb-6">Prefer to talk? Give us a call directly to discuss your event details.</p>
          <a href="tel:2142546448" class="flex items-center gap-4 text-3xl font-extrabold text-text-dark hover:text-primary-red transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            (214) 254-6448
          </a>
        </section>
      </div>

      <div class="bg-white p-10 rounded-3xl shadow-2xl border border-gray-100">
        <h2 class="text-3xl font-bold text-text-dark mb-2">Catering Inquiry</h2>
        <p class="text-text-muted mb-8">Tell us about your event and we'll get back to you with a custom quote.</p>
        
        <form class="space-y-6">
          <div class="grid grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-sm font-bold text-text-dark uppercase tracking-wider">First Name</label>
              <input type="text" placeholder="John" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all" required />
            </div>
            <div class="space-y-2">
              <label class="text-sm font-bold text-text-dark uppercase tracking-wider">Last Name</label>
              <input type="text" placeholder="Doe" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all" required />
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-sm font-bold text-text-dark uppercase tracking-wider">Email Address</label>
            <input type="email" placeholder="john@example.com" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all" required />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-bold text-text-dark uppercase tracking-wider">Event Date</label>
            <input type="date" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all" required />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-bold text-text-dark uppercase tracking-wider">Estimated Guest Count</label>
            <input type="number" placeholder="50" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all" required />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-bold text-text-dark uppercase tracking-wider">Tell us about your event</label>
            <textarea rows="4" placeholder="What's the occasion? Any specific menu items you're interested in?" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-red focus:ring-2 focus:ring-primary-red/20 outline-none transition-all resize-none" required></textarea>
          </div>

          <button type="submit" class="w-full bg-primary-red text-white py-4 rounded-xl font-bold text-xl hover:bg-red-700 transition-all transform hover:scale-[1.02] shadow-lg">
            Request Quote
          </button>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

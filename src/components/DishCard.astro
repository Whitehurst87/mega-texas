---
interface Props {
  image: string;
  name: string;
  badge?: string;
}

const { image, name, badge } = Astro.props;
---
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group hover:shadow-xl transition-all duration-300 relative">
  {badge && (
    <div class="absolute top-4 left-4 z-10 bg-primary-red text-white text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded shadow-lg">
      {badge}
    </div>
  )}
  <div class="h-64 overflow-hidden">
    <img 
      src={image} 
      alt={name} 
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
    />
  </div>
  <div class="p-6 text-center space-y-4">
    <h3 class="font-bold text-2xl text-text-dark">{name}</h3>
    <a href="/menu" class="inline-block bg-primary-red text-white px-6 py-2 rounded-lg font-bold hover:bg-red-700 transition-colors">
      View Menu
    </a>
  </div>
</div>

---
const mediaItems = [
  {
    type: "Podcast",
    source: "Monday Morning Podcast",
    author: "Bill Burr",
    quote: "The best barbecue I've ever had. I would eat perfect until I returned to Fresno just for this.",
    link: "#",
    tag: "National Praise"
  },
  {
    type: "News",
    source: "CBS News",
    author: "Local Segment",
    quote: "A Fresno staple that's putting Central Valley BBQ on the national map. Best of Central California winner.",
    link: "#",
    tag: "Local Legend"
  }
];

const featuredItem = {
  type: "Celebrity Visit",
  source: "Comedian & Actor",
  author: "Gabriel Iglesias",
  quote: "When I'm in Fresno, I know exactly where I'm going. This BBQ is something special — Fluffy approved!",
  image: "/images/Gabriel Iglesias.jpg",
  link: "#",
  tag: "Fluffy Approved"
};
---

<section class="bg-bg-light py-24 px-6 md:px-12 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-sm font-bold text-primary-red uppercase tracking-[0.2em] mb-4">Nationally Recognized</h2>
        <h3 class="text-4xl md:text-5xl font-extrabold text-text-dark leading-tight">In the Press</h3>
      </div>
      <p class="text-text-muted text-lg max-w-sm">
        From local awards to national comedy legends, our pit has caught the attention of those who know real BBQ.
      </p>
    </div>

    <!-- Featured item: Gabriel Iglesias -->
    <div class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100 mb-8 group hover:shadow-xl transition-all duration-300">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="w-full md:w-1/3 flex-shrink-0">
          <div class="relative overflow-hidden rounded-2xl">
            <img
              src={featuredItem.image}
              alt="Gabriel Iglesias"
              class="w-full h-64 md:h-80 object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>
        <div class="w-full md:w-2/3">
          <div class="flex justify-between items-start mb-6">
            <span class="bg-primary-red/10 text-primary-red text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{featuredItem.tag}</span>
            <span class="text-text-muted font-bold text-sm uppercase tracking-widest">{featuredItem.type}</span>
          </div>
          <p class="text-2xl md:text-3xl font-bold text-text-dark mb-6 leading-relaxed italic">
            "{featuredItem.quote}"
          </p>
          <div class="pt-6 border-t border-gray-50">
            <p class="font-bold text-text-dark text-lg">{featuredItem.author}</p>
            <p class="text-sm text-text-muted">{featuredItem.source}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {mediaItems.map(item => (
        <div class="bg-white p-10 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between group hover:shadow-xl transition-all duration-300">
          <div>
            <div class="flex justify-between items-start mb-8">
              <span class="bg-primary-red/10 text-primary-red text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{item.tag}</span>
              <span class="text-text-muted font-bold text-sm uppercase tracking-widest">{item.type}</span>
            </div>
            <p class="text-2xl font-bold text-text-dark mb-8 leading-relaxed italic">
              "{item.quote}"
            </p>
          </div>
          <div class="flex items-center justify-between pt-8 border-t border-gray-50">
            <div>
              <p class="font-bold text-text-dark">{item.author}</p>
              <p class="text-sm text-text-muted">{item.source}</p>
            </div>
            <a href={item.link} class="text-primary-red font-bold flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Listen / Watch
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
<footer class="bg-white py-16 px-6 md:px-12 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-center mb-12 md:mb-16">
      <img src="/images/logo.webp" alt="Mega Texas BBQ Logo" class="h-32 w-auto" />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="space-y-6">
        <h3 class="font-bold text-xl uppercase tracking-wider text-primary-red">Contact Info</h3>
        <ul class="space-y-3 text-text-muted font-medium">
          <li class="flex flex-col">
            <a href="tel:2142546448" class="text-text-dark hover:text-primary-red transition-colors text-lg font-bold">(214) 254-6448</a>
            <span class="text-[10px] uppercase tracking-tighter">Our Texas Roots, Our Fresno Pit</span>
          </li>
          <li>
            <p class="text-text-dark font-bold">3598 E. Butler Ave</p>
            <p class="text-xs uppercase">Fresno, California 93702</p>
          </li>
          <li><a href="mailto:mega_texas@yahoo.com" class="hover:text-primary-red transition-colors">mega_texas@yahoo.com</a></li>
        </ul>
      </div>
      
      <div class="space-y-6">
        <h3 class="font-bold text-xl uppercase tracking-wider text-primary-red">Quick Links</h3>
        <ul class="space-y-2 text-text-muted font-medium">
          <li><a href="/menu" class="hover:text-primary-red transition-colors">Digital Menu</a></li>
          <li><a href="/catering" class="hover:text-primary-red transition-colors">Catering Portal</a></li>
          <li><a href="/about" class="hover:text-primary-red transition-colors">Our Origin Story</a></li>
        </ul>
      </div>
      
      <div class="space-y-6">
        <h3 class="font-bold text-xl uppercase tracking-wider text-primary-red">Accolades</h3>
        <ul class="space-y-2 text-text-muted font-medium">
          <li class="flex items-center space-x-2 italic text-sm">
             <span class="text-primary-red italic font-bold">#1</span>
             <span>Best of Central California Winner</span>
          </li>
          <li class="flex items-center space-x-2 italic text-sm">
             <span class="text-primary-red italic font-bold">TOP 50</span>
             <span>Texas Monthly Best BBQ 2024</span>
          </li>
        </ul>
      </div>
      
      <div class="space-y-6 flex flex-col items-start lg:items-end">
        <h3 class="font-bold text-xl uppercase tracking-wider text-primary-red">Follow The Smoke</h3>
        <div class="flex space-x-4">
          <a href="https://www.facebook.com/megatexasbbq" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 bg-primary-red text-white rounded-full flex items-center justify-center hover:bg-red-700 transition-colors shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/mega_texas" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 bg-primary-red text-white rounded-full flex items-center justify-center hover:bg-red-700 transition-colors shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 text-[10px] uppercase tracking-widest text-text-muted font-bold">
      <p>Copyright © Mega Texas BBQ {new Date().getFullYear()}</p>
      <p>Established 2013 • Fresno, California</p>
    </div>
  </div>
</footer>

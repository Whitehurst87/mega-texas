---
---
<section class="relative bg-black py-16 md:py-24 px-6 md:px-12 overflow-hidden min-h-[80vh] flex items-center justify-center">
  <!-- Background Images -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/big%20plate%20of%20meat%20and%20sides.webp" 
      alt="Mega Texas Smoked Brisket Plate" 
      class="hidden md:block w-full h-full object-cover object-center opacity-80"
    />
    <img 
      src="/images/mobile%20hero%20bbq%20plate.jpg" 
      alt="Mega Texas BBQ Plate" 
      class="md:hidden w-full h-full object-cover object-center opacity-80"
    />
  </div>

  <!-- Cinematic Gradient Overlay -->
  <div class="absolute inset-0 z-10 bg-gradient-to-t from-black via-black/60 to-primary-red/40"></div>

  <!-- Content -->
  <div class="relative z-20 max-w-4xl mx-auto flex flex-col items-center text-center space-y-8 animate-in fade-in slide-in-from-bottom-8 duration-1000">
    <div class="inline-flex items-center space-x-3 bg-primary-red text-white px-6 py-2 border-2 border-white/20 transform -rotate-2 shadow-[6px_6px_0px_rgba(255,255,255,0.15)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span class="font-serif font-black tracking-widest uppercase text-sm md:text-base">Texas Monthly Top 50 BBQ 2024</span>
    </div>
    
    <h1 class="text-5xl md:text-7xl lg:text-8xl text-white font-extrabold leading-[1.1] drop-shadow-2xl">
      The Best Authentic Texas BBQ in Fresno
    </h1>
    
    <p class="text-xl md:text-2xl text-gray-200 max-w-2xl leading-relaxed drop-shadow-lg font-medium">
      Named one of the 50 best Texas-style BBQ joints in the country. From our "gas-roots" Arco station origins, we bring authentic Texas soul to the Central Valley.
    </p>
    
    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6 pt-4 w-full sm:w-auto justify-center">
      <a href="http://megatexasbbq.square.site/" target="_blank" rel="noopener noreferrer" class="inline-block bg-primary-red text-white px-10 py-4 rounded-xl font-bold text-xl hover:bg-red-700 transition-all transform hover:scale-105 shadow-2xl text-center border border-red-600">
        Order Now
      </a>
      <a href="/menu" class="inline-block bg-white/10 backdrop-blur-md text-white border border-white/30 px-10 py-4 rounded-xl font-bold text-xl hover:bg-white/20 transition-all transform hover:scale-105 shadow-xl text-center">
        View Menu
      </a>
    </div>
  </div>
</section>

---
interface Props {
  name: string;
  text: string;
}

const { name, text } = Astro.props;
---
<div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between hover:border-primary-red transition-colors duration-300">
  <div class="space-y-4">
    <div class="flex text-primary-red">
      {[...Array(5)].map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      ))}
    </div>
    <p class="text-text-muted italic leading-relaxed">
      "{text}"
    </p>
  </div>
  <div class="mt-8 pt-6 border-t border-gray-100 flex justify-between items-center">
    <span class="font-bold text-text-dark">{name}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-red"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </div>
</div>
